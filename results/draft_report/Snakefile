from itertools import chain
from pathlib import Path
import yaml
from os.path import normpath, exists, join
from shutil import copyfile, move, rmtree
from snakemake.utils import min_version


configfile: "draft_report_config.yaml"

# Extract Scenarios and Years keys
SCENARIOS = list(config["scenarios"].keys())
# We assume all scenarios have the same years defined.
# We take the years from the first scenario found in config.
YEARS = list(config["scenarios"][SCENARIOS[0]].keys())


# Helper function to find input network based on scenario AND year
def get_network(wildcards):
    # We cast wildcards.year to int because YAML usually parses 2030 as int,
    # but snakemake wildcards are strings by default.
    return config["scenarios"][wildcards.scenario][int(wildcards.year)]


rule all:
    input:
        # Expand to include scenarios and years
        expand("tables/congestion_income_metrics_{scenario}_{year}.csv",
            scenario=SCENARIOS,year=YEARS),
        expand("tables/producer_surplus_{scenario}_{year}.csv",
            scenario=SCENARIOS,year=YEARS),
        expand("tables/total_system_costs_{scenario}_{year}.csv",
            scenario=SCENARIOS,year=YEARS),

        # Comparisons (expanded by YEAR only, as they compare fixed scenarios)
        expand("plots/congestion_income_comparison_{year}.pdf",year=YEARS),
        expand("plots/netflow_comparison_{year}.pdf",year=YEARS),
        expand("plots/price_difference_comparison_{year}.pdf",year=YEARS),

        expand("plots/congestion_income_difference_{year}.pdf", year=YEARS),
        expand("plots/netflow_difference_{year}.pdf", year=YEARS),
        expand("plots/price_difference_difference_{year}.pdf", year=YEARS),

        expand("plots/congestion_income_relative_{year}.pdf", year=YEARS),
        expand("plots/netflow_relative_{year}.pdf", year=YEARS),
        expand("plots/price_difference_relative_{year}.pdf", year=YEARS),

        expand("plots/visualize_price_and_flow_effect_{year}.pdf",year=YEARS),
        expand("plots/visualize_price_and_flow_effect_alternative_{year}.pdf",year=YEARS),
        expand("plots/congestion_income_parity_plot_{year}.pdf",year=YEARS),
        expand("plots/congestion_income_parity_plot_per_interconnection_{year}.pdf",year=YEARS),
        expand("tables/comparison_total_system_costs_{year}.csv", year=YEARS),
        expand("plots/comparison_total_system_costs_{year}.pdf",year=YEARS),
        expand("tables/comparison_producer_surplus_{year}.csv",year=YEARS),
        expand("plots/comparison_producer_surplus_{year}.pdf", year=YEARS),
        expand("tables/comparison_consumer_surplus_{year}.csv", year=YEARS),
        expand("plots/comparison_consumer_surplus_{year}.pdf", year=YEARS),

        # Output for the Special Scenario: Explicit auction emulation - model run with forecast errors
        # Note: We only expand over YEARS here, because there is only one special scenario
        expand("tables/congestion_revenue_special_{year}.csv",year=YEARS),
        expand("plots/congestion_revenue_comparison_special_{year}.pdf", year=YEARS),

# --- Special Scenario Computations ---

rule compute_congestion_revenue:
    input:
        lambda wc: config["special_scenario"][int(wc.year)]
    output:
        "tables/congestion_revenue_special_{year}.csv"
    script:
        "../../scripts/compute_congestion_revenue.py"

rule compare_congestion_revenue:
    input:
        ci_sq = "tables/congestion_revenue_special_{year}.csv",
        ci_ex = "tables/congestion_income_timeseries_iem_{year}.csv",
        ci_iem = "tables/congestion_income_timeseries_iem_{year}.csv",
    output:
        "plots/congestion_revenue_comparison_special_{year}.pdf"
    script:
        "../../scripts/compare_congestion_revenue.py"

# --- Normal Scenario Computations ---

rule congestion_income_computation:
    input:
        get_network
    output:
        "tables/congestion_income_metrics_{scenario}_{year}.csv",
        "tables/congestion_income_timeseries_{scenario}_{year}.csv",
        "tables/price_difference_timeseries_{scenario}_{year}.csv",
        "tables/netflow_timeseries_{scenario}_{year}.csv",
    script:
        "../../scripts/compute_congestion_income.py"

rule producer_surplus_computation:
    input:
        get_network
    output:
        "tables/producer_surplus_{scenario}_{year}.csv"
    script:
        "../../scripts/compute_producer_surplus.py"

rule total_system_costs_computation:
    input:
        get_network
    output:
        "tables/total_system_costs_{scenario}_{year}.csv"
    script:
        "../../scripts/compute_total_system_costs.py"


# --- Comparison Rules (Status Quo vs IEM) per Year ---
# Note: These rules use {year} as a wildcard, but hardcode the scenario names
# in the input files because the scripts expect to compare specifically these two.

rule compare_congestion_income:
    input:
        ci_sq="tables/congestion_income_timeseries_status_quo_{year}.csv",
        ci_iem="tables/congestion_income_timeseries_iem_{year}.csv",
        nf_sq="tables/netflow_timeseries_status_quo_{year}.csv",
        nf_iem="tables/netflow_timeseries_iem_{year}.csv",
        pd_sq="tables/price_difference_timeseries_status_quo_{year}.csv",
        pd_iem="tables/price_difference_timeseries_iem_{year}.csv",
    output:
        plot_ci="plots/congestion_income_comparison_{year}.pdf",
        plot_nf="plots/netflow_comparison_{year}.pdf",
        plot_pd="plots/price_difference_comparison_{year}.pdf",
    script:
        "../../scripts/compare_congestion_income.py"


rule compare_congestion_income_difference:
    input:
        ci_sq="tables/congestion_income_timeseries_status_quo_{year}.csv",
        ci_iem="tables/congestion_income_timeseries_iem_{year}.csv",
        nf_sq="tables/netflow_timeseries_status_quo_{year}.csv",
        nf_iem="tables/netflow_timeseries_iem_{year}.csv",
        pd_sq="tables/price_difference_timeseries_status_quo_{year}.csv",
        pd_iem="tables/price_difference_timeseries_iem_{year}.csv",
    output:
        plot_ci_diff="plots/congestion_income_difference_{year}.pdf",
        plot_nf_diff="plots/netflow_difference_{year}.pdf",
        plot_pd_diff="plots/price_difference_difference_{year}.pdf",
    script:
        "../../scripts/compare_congestion_income_difference.py"



rule compare_congestion_income_relative:
    input:
        ci_sq="tables/congestion_income_timeseries_status_quo_{year}.csv",
        ci_iem="tables/congestion_income_timeseries_iem_{year}.csv",
        nf_sq="tables/netflow_timeseries_status_quo_{year}.csv",
