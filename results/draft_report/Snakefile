from itertools import chain
from pathlib import Path
import yaml
from os.path import normpath, exists, join
from shutil import copyfile, move, rmtree
from snakemake.utils import min_version


configfile: "draft_report_config.yaml"

SCENARIOS = config["scenarios"]


rule all:
    input:
        # dynamically expand scenario tables
        expand(f"tables/congestion_income_metrics_{{scenario}}.csv",
               scenario=SCENARIOS.keys()),
        expand(f"tables/producer_surplus_{{scenario}}.csv",
               scenario=SCENARIOS.keys()),
        # comparisons
        f"plots/congestion_income_comparison.pdf",
        f"tables/producer_surplus_change.csv",
        f"tables/consumer_surplus_change.csv",



rule congestion_income_computation:
    input:
        lambda wildcards: SCENARIOS[wildcards.scenario]["network"]
    output:
        f"tables/congestion_income_metrics_{{scenario}}.csv",
        f"tables/congestion_income_timeseries_{{scenario}}.csv",
        f"tables/prices_timeseries_{{scenario}}.csv",
        f"tables/netflows_timeseries_{{scenario}}.csv",
    script:
        "../../scripts/compute_congestion_income.py"


rule compare_congestion_income:
    input:
        status_quo = f"tables/congestion_income_metrics_status_quo.csv",
        iem = f"tables/congestion_income_metrics_iem.csv"
    output:
        f"plots/congestion_income_comparison.pdf"
    script:
        "../../scripts/compare_congestion_income.py"


rule producer_surplus_computation:
    input:
        lambda wildcards: SCENARIOS[wildcards.scenario]["network"]
    output:
        f"tables/producer_surplus_{{scenario}}.csv"
    script:
        "../../scripts/compute_producer_surplus.py"

rule compare_producer_surplus:
    input:
        status_quo = f"tables/producer_surplus_status_quo.csv",
        iem = f"tables/producer_surplus_iem.csv"
    output:
        f"tables/producer_surplus_change.csv"
    script:
        "../../scripts/compute_producer_surplus_change.py"


rule change_consumer_surplus_computation:
    input:
        network_status_quo = lambda wc: SCENARIOS["status_quo"]["network"],
        network_iem = lambda wc: SCENARIOS["iem"]["network"]
    output:
        f"tables/consumer_surplus_change.csv"
    script:
        "../../scripts/compute_consumer_surplus_change.py"
