rule compare_consumer_surplus:
    input:
        # Accessing the config directly using the wildcard year
        network_status_quo=lambda wc: config["scenarios"]["status_quo"][int(wc.year)],
        network_iem=lambda wc: config["scenarios"]["iem"][int(wc.year)]
