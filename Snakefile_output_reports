from itertools import chain
from pathlib import Path
import yaml
from os.path import normpath, exists, join
from shutil import copyfile, move, rmtree
from snakemake.utils import min_version


SCENARIOS:
    status_quo:
        network: "../resources/NT-1H-20251124/networks/base_s_all___2030.nc"
    iem:
        network: "../resources/NT-1H-20251124/networks/base_s_all___2040.nc"

RESULTS_PATH: "results/draft_report/"


rule all:
    input:
        # dynamically expand scenario tables
        expand(f"{RESULTS_PATH}/tables/congestion_income_{{scenario}}.csv",
               scenario=SCENARIOS.keys()),
        expand(f"{RESULTS_PATH}/tables/producer_surplus_{{scenario}}.csv",
               scenario=SCENARIOS.keys()),
        # comparisons
        f"{RESULTS_PATH}/plots/congestion_income_comparison.pdf",
        f"{RESULTS_PATH}/tables/producer_surplus_change.csv",
        f"{RESULTS_PATH}/tables/consumer_surplus_change.csv",


rule congestion_income_computation:
    input:
        lambda wildcards: SCENARIOS[wildcards.scenario]["network"]
    output:
        f"{RESULTS_PATH}/tables/congestion_income_{{scenario}}.csv"
    script:
        "scripts/compute_congestion_income.py"


rule compare_congestion_income:
    input:
        status_quo = f"{RESULTS_PATH}/tables/congestion_income_status_quo.csv",
        iem = f"{RESULTS_PATH}/tables/congestion_income_iem.csv"
    output:
        f"{RESULTS_PATH}/plots/congestion_income_comparison.pdf"
    script:
        "scripts/compare_congestion_income.py"


rule producer_surplus_computation:
    input:
        lambda wildcards: SCENARIOS[wildcards.scenario]["network"]
    output:
        f"{RESULTS_PATH}/tables/producer_surplus_{{scenario}}.csv"
    script:
        "scripts/compute_producer_surplus.py"

rule compare_producer_surplus:
    input:
        status_quo = f"{RESULTS_PATH}/tables/producer_surplus_status_quo.csv",
        iem = f"{RESULTS_PATH}/tables/producer_surplus_iem.csv"
    output:
        f"{RESULTS_PATH}/tables/producer_surplus_change.csv"
    script:
        "scripts/compute_producer_surplus_change.py"


rule change_consumer_surplus_computation:
    input:
        network_status_quo = lambda wc: SCENARIOS["status_quo"]["network"],
        network_iem = lambda wc: SCENARIOS["iem"]["network"]
    output:
        f"{RESULTS_PATH}/tables/consumer_surplus_change.csv"
    script:
        "scripts/compute_consumer_surplus_change.py"
